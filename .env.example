####################################
# APP
####################################

APP_NAME=

APP_ENV=development

APP_PORT=5000

APP_URL=http://localhost:5000

CLIENT_URL=http://localhost:3000

API_PREFIX=/api

API_VERSION=v1

####################################
# DATABASE
####################################

DB_URI=

DB_NAME=

####################################
# AUTH
####################################

JWT_ACCESS_SECRET=

JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES=15m

JWT_REFRESH_EXPIRES=30d

JWT_ISSUER=

JWT_AUDIENCE=

####################################
# COOKIE
####################################

COOKIE_ACCESS_NAME=access_token

COOKIE_REFRESH_NAME=refresh_token

COOKIE_SECURE=false

COOKIE_HTTP_ONLY=true

COOKIE_SAME_SITE=lax

####################################
# LOGGER
####################################

LOG_LEVEL=info

####################################
# SECURITY
####################################

BCRYPT_ROUNDS=12

TRUST_PROXY=false