####################################
# APP
####################################

APP_NAME=authArch

NODE_ENV=development

APP_PORT=5000

PORT=5000

APP_URL=http://localhost:5000

CLIENT_URL=http://localhost:3000

API_PREFIX=/api

API_VERSION=v1

####################################
# DATABASE
####################################

DB_URI=

DB_NAME=

DB_RETRY_LIMIT=

DB_RETRY_DELAY=
####################################
# AUTH
####################################

JWT_ACCESS_TOKEN=

JWT_REFRESH_TOKEN=

JWT_ACCESS_EXPIRES=

JWT_REFRESH_EXPIRES=

JWT_ISSUER=

JWT_AUDIENCE=

####################################
# COOKIE
####################################

COOKIE_ACCESS_NAME=access_token

COOKIE_REFRESH_NAME=refresh_token

COOKIE_SECURE=false

COOKIE_HTTP_ONLY=true

COOKIE_SAME_SITE=lax

COOKIE_ACCESS_MAX_AGE=15*60*1000,
        
COOKIE_REFRESH_MAX_AGE= 30*24*60*60*1000,


####################################
# LOGGER
####################################

LOG_LEVEL=[enums]//inof

####################################
# SECURITY
####################################

BCRYPT_ROUNDS=numeric

TRUST_PROXY=boolean